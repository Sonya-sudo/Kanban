<Window x:Class="Kanban.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи" Height="700" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Название (текст) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Название (поле) -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Описание (текст) -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Описание (поле) -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Приоритет (текст) -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Приоритет (поле) -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Дедлайн (текст) -->
            <RowDefinition Height="Auto"/>
            <!-- 8: Дедлайн (поле) -->
            <RowDefinition Height="Auto"/>
            <!-- 9: Подзадачи (текст) -->
            <RowDefinition Height="Auto"/>
            <!-- 10: Список подзадач -->
            <RowDefinition Height="Auto"/>
            <!-- 11: Добавление подзадачи -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование задачи" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Название" FontWeight="SemiBold"/>
        <TextBox Grid.Row="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5,0,15" Height="35"/>

        <TextBlock Grid.Row="3" Text="Описание" FontWeight="SemiBold"/>
        <TextBox Grid.Row="4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5,0,15" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

        <TextBlock Grid.Row="5" Text="Приоритет" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="6" SelectedValue="{Binding Priority}" SelectedValuePath="Content" Margin="0,5,0,15">
            <ComboBoxItem Content="high"/>
            <ComboBoxItem Content="medium"/>
            <ComboBoxItem Content="low"/>
        </ComboBox>

        <TextBlock Grid.Row="7" Text="Дедлайн" FontWeight="SemiBold"/>
        <DatePicker Grid.Row="8" SelectedDate="{Binding Deadline}" Margin="0,5,0,15"/>

        <!-- Подзадачи -->
        <TextBlock Grid.Row="9" Text="Подзадачи" FontWeight="SemiBold" Margin="0,10,0,5"/>

        <TreeView Grid.Row="10" ItemsSource="{Binding Subtasks}" Margin="0,5,0,15" Height="150">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="200" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                        <Button Content="+" Width="25"
                                Command="{Binding AddChildCommand}"
                                CommandParameter="{Binding ElementName=NewSubtaskBox, Path=Text}"
                                Background="Transparent" BorderThickness="0" Foreground="#3B82F6" Cursor="Hand"
                                Margin="0,0,5,0"/>
                        <Button Content="🗑" Width="25"
                                Command="{Binding RemoveCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#EF4444" Cursor="Hand"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,5,0,15">
            <TextBox x:Name="NewSubtaskBox" Width="300" Height="30" Margin="0,0,10,0"/>
            <Button Content="+ Добавить подзадачу" Height="30"
                    Command="{Binding AddRootSubtaskCommand}" 
                    CommandParameter="{Binding ElementName=NewSubtaskBox}"
                    Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="✅ Завершить задачу" Width="120" Margin="5"
                    Command="{Binding CompleteTaskCommand}"
                    Background="#10B981" Foreground="White"
                    Visibility="{Binding IsInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Отмена" Width="80" Margin="5" Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Width="80" Margin="5" Command="{Binding SaveCommand}" 
                    Background="#3B82F6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>