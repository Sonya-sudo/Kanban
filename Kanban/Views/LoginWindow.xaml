<Window x:Class="Kanban.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="450" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📋 Kanban Доска" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <TextBlock Grid.Row="1" Text="Email" FontWeight="SemiBold" Margin="0,5"/>
        <TextBox Grid.Row="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5" Height="35" Padding="10" FontSize="14"/>

        <TextBlock Grid.Row="3" Text="Пароль" FontWeight="SemiBold" Margin="0,10,0,5"/>
        <PasswordBox Grid.Row="4" x:Name="PasswordBox" Margin="0,5" Height="35" 
                     Padding="10" FontSize="14"/>

        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red" 
                   TextWrapping="Wrap" Margin="0,10"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20">
            <Button Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=PasswordBox}"
                    Content="Войти" Width="100" Height="35" 
                    Margin="5" Background="#3B82F6" Foreground="White"
                    FontWeight="SemiBold" Cursor="Hand"/>
            <Button Command="{Binding RegisterCommand}"
                    CommandParameter="{Binding ElementName=PasswordBox}"
                    Content="Регистрация" Width="100" Height="35" 
                    Margin="5" Background="#F1F5F9" Foreground="#1E293B"
                    FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>