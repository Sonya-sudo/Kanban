<Window x:Class="Kanban.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История задач" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="✅ Завершённые задачи" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding CompletedTasks}"
                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                 Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,2"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat=📅 Создана: dd.MM.yyyy}" 
                                           FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="60" Height="20" CornerRadius="4" Margin="10,0,0,0"
                                    Background="{Binding Priority}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Priority}" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="2" Text="{Binding Deadline, StringFormat=📆 dd.MM.yyyy}" 
                                       FontSize="11" Foreground="#64748B" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🔄 Вернуть в работу" Width="150" Margin="5"
                    Command="{Binding RestoreTaskCommand}"
                    IsEnabled="{Binding HasSelectedTasks}"/>
            <Button Content="Закрыть" Width="80" Margin="5" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>