<Window x:Class="Kanban.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименование" Height="160" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите новое название доски:" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="AnswerBox" Text="{Binding Answer}" 
                 Margin="0,0,0,15" Height="30"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="60" Margin="5" Click="OkButton_Click"/>
            <Button Content="Отмена" Width="60" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>